<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Lets employees browse the Training Library, watch videos, and have their views tracked.</description>
    <label>Training Library Access</label>
    <hasActivationRequired>false</hasActivationRequired>

    <classAccesses>
        <apexClass>TrainingVideoController</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- Videos & folders: read-only for employees -->
    <objectPermissions>
        <object>Training_Video__c</object>
        <allowRead>true</allowRead>
        <allowCreate>false</allowCreate>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Training_Folder__c</object>
        <allowRead>true</allowRead>
        <allowCreate>false</allowCreate>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <!-- Views: employees create/update their own tracking rows -->
    <objectPermissions>
        <object>Training_View__c</object>
        <allowRead>true</allowRead>
        <allowCreate>true</allowCreate>
        <allowEdit>true</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <fieldPermissions>
        <field>Training_Video__c.Description__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Training_Video__c.Folder__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Training_Video__c.Category__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Training_Video__c.Status__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Training_Video__c.Duration_Seconds__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Training_Video__c.Video_Content_Version_Id__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Training_Video__c.Sort_Order__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>

    <fieldPermissions>
        <field>Training_Folder__c.Description__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Training_Folder__c.Parent_Folder__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Training_Folder__c.Sort_Order__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Training_Folder__c.Icon__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>

    <fieldPermissions>
        <field>Training_View__c.Training_Video__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Training_View__c.User__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Training_View__c.Status__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Training_View__c.Watch_Percent__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Training_View__c.First_Viewed_At__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Training_View__c.Last_Viewed_At__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Training_View__c.Completed_At__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Training_View__c.View_Count__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Training_View__c.User_Video_Key__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>

    <tabSettings>
        <tab>Training_Library</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Training_Video__c</tab>
        <visibility>Available</visibility>
    </tabSettings>
</PermissionSet>
