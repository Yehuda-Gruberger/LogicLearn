<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Video_Link__c</fullName>
    <label>Video Link</label>
    <formula>LEFT($Api.Enterprise_Server_URL_260, FIND(".my.salesforce.com", $Api.Enterprise_Server_URL_260) - 1) &amp; ".lightning.force.com/lightning/n/logiclearn__Training_Library?c__videoId=" &amp; CASESAFEID(Id)</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <externalId>false</externalId>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
    <inlineHelpText>Deep link that opens this specific video in the Training Library. Use as a merge field in the notification email.</inlineHelpText>
</CustomField>
